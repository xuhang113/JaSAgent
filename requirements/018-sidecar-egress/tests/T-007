#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-007"
result_text='实现改动覆盖 `jasagent-sidecar`，以及把出站挂到 sidecar 所必需的 `jasagent-app`、`jasagent-llm` 和脚本。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  base="${ATDD_SPEC_BASE}"
  if ! git -C "${REPO_ROOT}" merge-base --is-ancestor "${base}" HEAD; then
    echo "当前 HEAD 不包含已确认的规格提交 ${base}。" >&2
    exit 1
  fi
  changed="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "自规格提交起的改动文件数" "$(printf '%s\n' "${changed}" | sed '/^$/d' | wc -l | tr -d ' ')" >> "${ATDD_LOG}"
  for prefix in jasagent-sidecar/ jasagent-app/ jasagent-llm/ scripts/; do
    if ! grep -q "^${prefix}" <<< "${changed}"; then
      echo "实现没有改到 ${prefix}。" >&2
      exit 1
    fi
  done
  # 验收第 1 条还要求离开集群的 MCP 与外部工具走同一路径。
  if ! grep -q '^jasagent-mcp/' <<< "${changed}" || ! grep -q '^jasagent-plugin/' <<< "${changed}"; then
    echo "实现没有把 jasagent-mcp 或 jasagent-plugin 接到 sidecar。" >&2
    exit 1
  fi
  if [[ ! -x "${REPO_ROOT}/scripts/test-018-sidecar-egress.sh" ]]; then
    echo "缺少可执行的合同测试脚本。" >&2
    exit 1
  fi
  if [[ ! -f "${REPO_ROOT}/changelog/2026-11-15-sidecar-egress.md" ]]; then
    echo "缺少本轮变更记录。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "覆盖 sidecar、app、llm、脚本以及 MCP 与外部工具" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
