#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='sidecar 对 `/v1/forward` 的请求体和响应体做流式转发，不再整包缓冲。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  if grep -R -n -E 'readAllBytes|ofByteArray' "${REPO_ROOT}/jasagent-sidecar/src/main" >/dev/null; then
    echo "sidecar 转发仍在整包读取正文。" >&2
    grep -R -n -E 'readAllBytes|ofByteArray' "${REPO_ROOT}/jasagent-sidecar/src/main" >&2
    exit 1
  fi
  upstream="${REPO_ROOT}/jasagent-sidecar/src/main/java/dev/jasagent/sidecar/JdkUpstreamClient.java"
  controller="${REPO_ROOT}/jasagent-sidecar/src/main/java/dev/jasagent/sidecar/EgressController.java"
  forward="${REPO_ROOT}/jasagent-llm/src/main/java/dev/jasagent/llm/egress/SidecarForward.java"
  transport="${REPO_ROOT}/jasagent-llm/src/main/java/dev/jasagent/llm/egress/SidecarLlmTransport.java"
  if ! grep -q 'BodyHandlers.ofInputStream()' "${upstream}"; then
    echo "上游客户端没有按流接收响应。" >&2
    exit 1
  fi
  if ! grep -q 'BodyPublishers.ofInputStream' "${upstream}"; then
    echo "上游客户端没有按流发送请求体。" >&2
    exit 1
  fi
  if ! grep -q 'copy(outcome.body(), response)' "${controller}"; then
    echo "sidecar 入口没有把响应流拷贝给调用方。" >&2
    exit 1
  fi
  if ! grep -q 'BodyHandlers.ofInputStream()' "${forward}"; then
    echo "调用方没有按流读取 /v1/forward 的响应。" >&2
    exit 1
  fi
  if ! grep -q '不先收完整段' "${transport}"; then
    echo "大模型传输没有保持流式。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "请求和响应按流转发" "通过" >> "${ATDD_LOG}"
  atdd_mvn_test "jasagent-sidecar,jasagent-llm" "SidecarStreamTest,SidecarLlmTransportTest"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "流式转发不再整包缓冲" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
