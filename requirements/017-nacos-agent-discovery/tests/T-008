#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-008"
result_text='网关仍按单副本约定：登录会话和存活探测留在网关进程内。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  props="${REPO_ROOT}/jasagent-gateway/src/main/resources/application.properties"
  config="${REPO_ROOT}/jasagent-gateway/src/main/java/dev/jasagent/gateway/config/GatewayConfiguration.java"
  router="${REPO_ROOT}/jasagent-gateway/src/main/java/dev/jasagent/gateway/route/StickyAgentRouter.java"
  if ! grep -q 'jasagent.gateway.replicas=1' "${props}"; then
    echo "配置没有写明网关单副本。" >&2
    exit 1
  fi
  if ! grep -q '登录会话和存活探测都在网关进程内，本轮网关按单副本验收' "${config}"; then
    echo "配置类没有写明单副本和进程内会话、存活探测。" >&2
    exit 1
  fi
  if ! grep -q '登录会话和存活探测都在网关进程内，本轮网关按单副本验收' "${router}"; then
    echo "路由器没有写明单副本约定。" >&2
    exit 1
  fi
  if ! grep -q 'public InMemoryAgentLiveness agentLiveness(' "${config}"; then
    echo "存活探测没有留在网关进程内。" >&2
    exit 1
  fi
  if ! grep -q 'public LocalAuthService localAuthService(' "${config}"; then
    echo "登录会话没有留在网关进程内。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "单副本与进程内会话、存活探测" "通过" >> "${ATDD_LOG}"
  atdd_mvn_test "GatewayLayoutTest,NacosContractTest"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "单副本约定" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
