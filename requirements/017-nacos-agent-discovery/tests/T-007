#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-007"
result_text='已经没有可用实例时，需要转发到 agent 的请求失败，且不删除粘性行。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  router="${REPO_ROOT}/jasagent-gateway/src/main/java/dev/jasagent/gateway/route/StickyAgentRouter.java"
  if ! grep -q '没有可用的 agent' "${router}"; then
    echo "没有可用实例时没有失败说明。" >&2
    exit 1
  fi
  if grep -E 'store\\.(delete|remove|deleteTenant)\\(' "${router}"; then
    echo "路由器在失败路径里删除了粘性行。" >&2
    exit 1
  fi
  if ! grep -q '不删除已有粘性' "${router}"; then
    echo "路由器没有写明失败时保留粘性行。" >&2
    exit 1
  fi
  test_file="${REPO_ROOT}/jasagent-gateway/src/test/java/dev/jasagent/gateway/route/NacosStickyRoutingTest.java"
  if ! grep -q 'emptyOrDownDiscoveryKeepsTheStickyRow' "${test_file}"; then
    echo "缺少失败且不删行的模块测试。" >&2
    exit 1
  fi
  atdd_mvn_test "NacosStickyRoutingTest"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "无可用实例时失败且保留粘性行" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
