#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-001"
result_text='agent 启动就绪后向 Nacos 注册；注册地址是网关能访问的非回环地址，不是 `127.0.0.1`、`localhost` 或其它回环地址。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  registration="${REPO_ROOT}/jasagent-app/src/main/java/dev/jasagent/app/nacos/NacosAgentRegistration.java"
  reachable="${REPO_ROOT}/jasagent-app/src/main/java/dev/jasagent/app/nacos/ReachableAddress.java"
  if [[ ! -f "${registration}" || ! -f "${reachable}" ]]; then
    echo "缺少注册或可达地址实现。" >&2
    exit 1
  fi
  if ! grep -q 'void registerReady(' "${registration}"; then
    echo "就绪后没有注册入口。" >&2
    exit 1
  fi
  if ! grep -q 'ReachableAddress.require(settings.advertiseHost())' "${registration}"; then
    echo "注册没有使用广告地址，也没有校验可达性。" >&2
    exit 1
  fi
  if ! grep -q 'ReachableAddress.loopbackBind(settings.bindAddress())' "${registration}"; then
    echo "只监听回环时没有拒绝注册。" >&2
    exit 1
  fi
  if ! grep -q 'localhost' "${reachable}" || ! grep -q 'is_loopback\|isLoopback\|LOOPBACK' "${reachable}"; then
    echo "可达地址检查没有覆盖回环或 localhost。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "注册入口使用非回环广告地址" "通过" >> "${ATDD_LOG}"
  atdd_mvn_test "ReachableAddressTest,NacosRegistrationTest,NacosRegistrationSpringTest"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "就绪后注册非回环地址" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
