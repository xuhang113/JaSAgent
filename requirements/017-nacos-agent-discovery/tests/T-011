#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-011"
result_text='实现和测试提交不修改 `deploy/k8s` 下的清单文件，也不修改 sidecar 产品代码。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  base="${ATDD_SPEC_BASE}"
  if ! git -C "${REPO_ROOT}" merge-base --is-ancestor "${base}" HEAD; then
    echo "当前 HEAD 不包含已确认的规格提交 ${base}。" >&2
    exit 1
  fi
  changed="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD -- deploy/k8s jasagent-sidecar scripts/k8s/probe-egress.sh)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "自规格提交起的清单、sidecar 和官方探测改动" "${changed:-无}" >> "${ATDD_LOG}"
  if [[ -n "${changed}" ]]; then
    echo "从规格提交起已改动 deploy/k8s、sidecar 产品代码或官方探测脚本：" >&2
    printf '%s\n' "${changed}" >&2
    exit 1
  fi
  dirty="$(git -C "${REPO_ROOT}" status --porcelain -- deploy/k8s jasagent-sidecar scripts/k8s/probe-egress.sh)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "工作区清单、sidecar 和官方探测" "${dirty:-干净}" >> "${ATDD_LOG}"
  if [[ -n "${dirty}" ]]; then
    echo "工作区改动了 deploy/k8s、sidecar 产品代码或官方探测脚本：" >&2
    printf '%s\n' "${dirty}" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "未改清单、sidecar 和官方探测" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
