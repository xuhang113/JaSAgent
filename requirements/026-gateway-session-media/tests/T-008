    jasagent-gateway/src/test/java/dev/jasagent/gateway/SessionMediaReplicaTest.java \
    jasagent-gateway/src/test/java/dev/jasagent/gateway/media/AttachmentMediaTest.java \
    jasagent-gateway/src/test/java/dev/jasagent/gateway/media/AttachmentPathsTest.java \
    jasagent-persist/src/test/java/dev/jasagent/persist/SessionAttachmentLedgerTest.java \
    jasagent-web/frontend/src/sessionMedia.spec.js \
    jasagent-web/frontend/src/views/ConsoleMedia.spec.js \
    jasagent-gateway/src/test/java/dev/jasagent/gateway/jaeger/JaegerPathsTest.java \
    jasagent-gateway/src/test/java/dev/jasagent/gateway/JaegerProxyTest.java \
    jasagent-web/src/test/java/dev/jasagent/web/upstream/JaegerConsoleLinkTest.java; do
    if [[ ! -f "${REPO_ROOT}/${testf}" ]]; then
