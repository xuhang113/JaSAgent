#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-007"
result_text='`/admin/cluster` 和 `/admin/jaeger` 不能作为跨租户取附件的旁路。附件路径规范化后不能绕过前缀，也不能落到默认的 agent 转发。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "adminPagesAreNotAnAttachmentBypass"
  atdd_require_pass gateway "collectionAndItemStayOnTheGateway"
  atdd_require_pass gateway "obfuscationStillIntersectsThePrefix"
  atdd_require_pass gateway "requestUriAndServletPathMustAgree"
  atdd_require_pass gateway "dotDotDoesNotReachTheChain"
  atdd_require_pass gateway "missingSessionDoesNotContinue"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "admin 入口不是附件旁路，路径规范化后不绕过前缀、不落到 agent" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
