#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='已登录用户经网关、用现有登录会话 Cookie，在自己的会话里实际上传一份允许的图片、一份允许的语音和一份允许的视频，随后能取回与上传完全相同的字节，并在 IM 壳中展示图片或播放语音、视频。不能只查存储类名或路径存在。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  "${HERE}/web-tests.sh"
  atdd_require_pass gateway "allowedImageAudioAndVideoRoundTrip"
  atdd_require_pass web "frontend:用网关路径展示图片并播放语音、视频"
  atdd_require_pass web "frontend:只把名单里的类型画成图片、语音或视频"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "图片、语音和视频经网关实际上传并取回同一份字节，IM 壳可展示或播放" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
