#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-001"
result_text='未登录访问附件的上传和下载，都返回 401，且 `errorCode` 为 `AUTH`。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "anonymousUploadAndDownloadAreAuth"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "未登录上传和下载都是 401 AUTH" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
