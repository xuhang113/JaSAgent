#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-003"
result_text='类型和大小按本规格写明的允许名单和上限执行。服务端以探测到的实际内容类型为准，不能只看扩展名或客户端 `Content-Type`。不在名单中的类型（含 SVG、HTML、XML 和宽泛的 `video/*`）被拒绝；超过对应类型大小上限的请求被拒绝；超限时元数据和内容都不落库。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "sniffAcceptsTheAllowList"
  atdd_require_pass gateway "sniffRejectsMarkupAndBroadVideo"
  atdd_require_pass gateway "limitsFollowTheDetectedType"
  atdd_require_pass gateway "rejectedTypeAndSizeLeaveNoRow"
  atdd_require_pass gateway "rawBodyIsTheFile"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "按探测类型执行允许名单和上限，超限不落库" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
