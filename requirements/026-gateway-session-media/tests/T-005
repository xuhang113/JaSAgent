#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-005"
result_text='从一个就绪网关副本上传后，必须从「不是接收上传的那一个就绪副本」取回同一份字节。ATDD 用共享的已有 MySQL（或同等可被双进程同时用的存储）验证，不依赖集群附件卷。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "twoProcessesShareMysqlBytes"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "从一个进程上传后，另一个就绪进程取回同一份字节" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
