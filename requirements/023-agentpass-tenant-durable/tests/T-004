#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='`GET /v1/tickets/audit` 未鉴权应 401 或 403，不得再回全部流水；已登录也只能看本租户。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/live.sh"
  atdd_require_live_pass "audit-unauthenticated"
  atdd_require_live_pass "audit-query-ignored"
  atdd_require_live_pass "audit-alice-only"
  atdd_require_live_pass "audit-bob-cookie"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "未鉴权 audit 被拒，已登录只看本租户" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
