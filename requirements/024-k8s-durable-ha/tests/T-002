#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-002"
result_text='非 admin 不能打到集群接口或他人会话。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_gateway_pass "nonAdminCannotReachClusterApiOrPage"
  atdd_require_gateway_pass "clusterIsAdminOnlyAndImportedOperatorKeepsAdmin"
  atdd_require_gateway_pass "gatewayRejectsForeignSessionsBeforeForwarding"
  atdd_require_gateway_pass "anonymousCallsDoNotLeakBusinessData"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "非 admin 进不了集群接口，他人会话被拒绝" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
