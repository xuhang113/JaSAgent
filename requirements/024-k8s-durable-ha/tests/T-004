#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='`JASAGENT_GATEWAY_FORWARDED_TRUSTED` 仍只信任 Ingress，取值禁止 `0.0.0.0/0` 或 `::/0`。任意客户端自己带来的 `X-Forwarded-*` 不被信任。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_gateway_pass "forwardedTrustRejectsTheWholeInternet"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "转发头合同测试" "通过" >> "${ATDD_LOG}"
  props="${REPO_ROOT}/jasagent-gateway/src/main/resources/application.properties"
  if ! grep -q 'jasagent.gateway.forwarded.trusted=${JASAGENT_GATEWAY_FORWARDED_TRUSTED:}' "${props}"; then
    echo "转发头信任不再只从 Ingress 这一跳的环境变量读取。" >&2
    exit 1
  fi
  if grep -E '^jasagent\.gateway\.forwarded\.trusted=.*0\.0\.0\.0/0' "${props}" >/dev/null; then
    echo "转发头信任被写成了 0.0.0.0/0。" >&2
    exit 1
  fi
  if grep -E '^jasagent\.gateway\.forwarded\.trusted=.*::/0' "${props}" >/dev/null; then
    echo "转发头信任被写成了 ::/0。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "缺省转发头仍只从环境变量读取，不是全网段" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
