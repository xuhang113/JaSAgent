#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='网关只反代到配置里的 Jaeger 上游，地址不能被请求改写。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "upstreamComesOnlyFromConfiguration"
  atdd_require_pass gateway "adminIsProxiedWithoutSessionOrRewrittenHost"
  props="${REPO_ROOT}/jasagent-gateway/src/main/resources/application.properties"
  if ! grep -q 'jasagent.gateway.jaeger-origin=${JASAGENT_GATEWAY_JAEGER_ORIGIN:}' "${props}"; then
    echo "Jaeger 上游缺省没有保持为空。" >&2
    exit 1
  fi
  if grep -RIn --include='*.java' --include='*.properties' -E 'NodePort|nodePort' \
    "${REPO_ROOT}/jasagent-gateway/src/main" >/dev/null; then
    echo "网关实现里出现了 NodePort，实现阶段不应把 Jaeger 做成 NodePort。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "上游只来自配置，不能被请求改写，缺省为空且未做 NodePort" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
