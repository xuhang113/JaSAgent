#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-002"
result_text='配置了非空 `jasagent.otel.endpoint` 之后，走一条会打点的执行（不走 Funnel）。测试用 OTLP 接收端能收到根 span `jasagent.execution`，不只查导出器类名。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/app-tests.sh"
  atdd_require_pass app "configuredEndpointExportsExecutionRootSpan"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "配置端点后接收端收到根 span jasagent.execution" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
