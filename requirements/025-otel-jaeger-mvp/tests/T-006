#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-006"
result_text='Span 里不得带密码、Token、Authorization 或 Cookie。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/app-tests.sh"
  atdd_require_pass app "configuredEndpointExportsExecutionRootSpan"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "导出正文和请求不含密码、Token、Authorization 或 Cookie" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
