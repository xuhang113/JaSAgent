#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-005"
result_text='反代不把登录会话 Cookie 转给 Jaeger，也不接受 Jaeger 的 `Set-Cookie` 覆盖网关会话 Cookie。该判断和反代不依赖单进程状态。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "adminIsProxiedWithoutSessionOrRewrittenHost"
  atdd_require_pass gateway "proxyKeepsUpstreamCookiesAndPrefix"
  atdd_require_pass gateway "loginSessionIsVisibleToAnotherReplica"
  python3 - "${REPO_ROOT}" <<'CHK'
from pathlib import Path
import sys

repo = Path(sys.argv[1])
proxy = (repo / "jasagent-gateway/src/main/java/dev/jasagent/gateway/jaeger/JaegerProxyFilter.java").read_text(encoding="utf-8")
access = (repo / "jasagent-gateway/src/main/java/dev/jasagent/gateway/cluster/ClusterAccessFilter.java").read_text(encoding="utf-8")
if "GatewaySessionFilter" not in proxy:
    raise SystemExit("反代没有沿用网关会话过滤。")
if "JaegerPaths.matches" not in access:
    raise SystemExit("admin 判断没有把 Jaeger 前缀交给与集群页同一套过滤。")
if "new ConcurrentHashMap" in proxy or "new HashMap" in proxy:
    raise SystemExit("Jaeger 反代出现了进程内会话或路由表。")
print("process-local-ok")
CHK
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "不转发也不覆盖会话 Cookie，判断沿用已有会话且不依赖单进程表" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
