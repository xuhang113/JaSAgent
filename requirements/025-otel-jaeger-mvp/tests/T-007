#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-007"
result_text='控制台只给 admin 普通链接，不是 Vue 路由，也不把 `/admin/jaeger` 加入 ConsolePages。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/web-tests.sh"
  atdd_require_pass web "jaegerEntryIsAnAdminAnchorOutsideTheRouter"
  atdd_require_pass web "frontend:没有把 Jaeger 注册成页面路由"
  atdd_require_pass web "frontend:admin 能看到指向 Jaeger 的普通链接"
  atdd_require_pass web "frontend:普通用户看不到 Jaeger 入口"
  router="${REPO_ROOT}/jasagent-web/frontend/src/router.js"
  pages="${REPO_ROOT}/jasagent-web/src/main/java/dev/jasagent/web/upstream/ConsolePages.java"
  if grep -F -q "jaeger" "${router}"; then
    echo "Vue 路由表里出现了 jaeger。" >&2
    exit 1
  fi
  if grep -F -q "/admin/jaeger" "${pages}"; then
    echo "ConsolePages 把 /admin/jaeger 收进了单页入口。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "admin 普通链接存在，不是 Vue 路由，也未加入 ConsolePages" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
