#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-003"
result_text='`/admin/jaeger` 及其所有子路径与 `/admin/cluster` 同一套判断：未登录的页面请求转到 `/admin/login`；已登录的非 admin 回 403，且不能落到控制台单页。前缀不能被绕过。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  "${HERE}/gateway-tests.sh"
  atdd_require_pass gateway "anonymousJaegerRedirectsToLogin"
  atdd_require_pass gateway "userCannotOpenJaeger"
  atdd_require_pass gateway "prefixCannotFallThroughToTheConsole"
  atdd_require_pass gateway "prefixCoversEncodingsAndStopsAtTheBoundary"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "未登录转到登录页，非 admin 回 403，前缀不能绕过或落到控制台" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
