#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
mkdir -p "$HERE/../results" "$HERE/../logs"
name="T-042"
result_text='调用 `clock` 之后，按 `clock` 查到的失败次数与调用前相同。'
cd "$ROOT"
start=$(python3 -c 'import time; print(int(time.time()*1000))')
set +e
mvn -pl jasagent-tool -am test -Dsurefire.failIfNoSpecifiedTests=false -Dtest=ExternalUsageTest#clockLeavesFailureUnchanged > "$HERE/../logs/${name}.log" 2>&1
code=$?
set -e
end=$(python3 -c 'import time; print(int(time.time()*1000))')
elapsed=$((end - start))
if [[ $code -eq 0 ]]; then
  status="通过"
else
  status="失败"
fi
printf '%s\t%s\t%s\t%s\tlogs/%s.log\n' "$name" "$status" "$result_text" "$elapsed" "$name" > "$HERE/../results/${name}.txt"
exit "$code"
