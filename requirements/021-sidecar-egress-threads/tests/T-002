#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-002"
result_text='把 sidecar 的 Tomcat 平台工作线程故意压低后，仍能同时扛住超过该上限的长流式 `/v1/forward`。这些流要持续出块，首块须在上游结束前到达，证明没有整包缓冲。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  atdd_mvn_test "jasagent-sidecar" "SidecarPlatformThreadTest#longStreamsExceedPlatformWorkers"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "压低平台线程后并发长流持续出块且首块先到" "通过" >> "${ATDD_LOG}"


  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
