#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-006"
result_text='018 规格第 1 到 9 条的行为约定仍然成立，本轮复跑须通过：离开集群的 HTTP 仍由 agent 经 `/v1/forward` 发出；Nacos（含 gRPC 9848）、MySQL、Redis、网关和本集群服务不经 sidecar；向 Nacos 注册的仍是非回环地址；`/v1/forward` 对请求体和响应体做流式转发；大模型白名单和票据核销规则仍然有效；本机启动脚本拉起 sidecar，两台 agent 可共用一个回环 sidecar。本轮不要求再改 `jasagent-app` / `jasagent-llm`。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail


  if git -C "${REPO_ROOT}" diff --name-only "${ATDD_SPEC_BASE}" HEAD -- jasagent-app jasagent-llm | grep -q .; then
    echo "本轮改了 jasagent-app 或 jasagent-llm。" >&2
    git -C "${REPO_ROOT}" diff --name-only "${ATDD_SPEC_BASE}" HEAD -- jasagent-app jasagent-llm >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "本轮未改 app 和 llm" "通过" >> "${ATDD_LOG}"
  atdd_mvn_test "jasagent-sidecar" "SidecarEgressTest,SidecarHealthTest,SidecarContractTest,SidecarStreamTest,TicketWireTest,LlmAllowlistTest"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "018 白名单、票据、流式和健康检查" "通过" >> "${ATDD_LOG}"
  if ! grep -R -n -E '/v1/forward' "${REPO_ROOT}/jasagent-app/src" "${REPO_ROOT}/jasagent-llm/src" >/dev/null; then
    echo "agent 侧不再经 /v1/forward 出站。" >&2
    exit 1
  fi
  if ! grep -R -n -E 'start.*sidecar|sidecar' "${REPO_ROOT}/scripts/start.sh" >/dev/null; then
    echo "本机启动脚本不再拉起 sidecar。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "出站仍经 sidecar 且本机脚本仍拉起 sidecar" "通过" >> "${ATDD_LOG}"


  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
