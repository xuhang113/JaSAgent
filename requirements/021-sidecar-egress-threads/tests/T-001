#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-001"
result_text='`/v1/forward` 在等待 agentpass、上游或抄写流式响应期间，不占用 Tomcat 平台工作线程（操作系统上的平台线程，不是虚拟线程或请求槽位）。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  atdd_mvn_test "jasagent-sidecar" \
    "SidecarPlatformThreadTest#waitingForAgentpassDoesNotHoldPlatformWorkers,SidecarPlatformThreadTest#waitingForUpstreamHeadersDoesNotHoldPlatformWorkers,SidecarPlatformThreadTest#longStreamsExceedPlatformWorkers"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "等待和抄写不占平台工作线程" "通过" >> "${ATDD_LOG}"


  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
