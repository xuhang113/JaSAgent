#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-006"
result_text='实现只改 `jasagent-gateway`。`jasagent-web` 本轮不被修改。实现和测试提交不修改 `deploy/k8s` 下的清单文件。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  base="${ATDD_SPEC_BASE}"
  if ! git -C "${REPO_ROOT}" merge-base --is-ancestor "${base}" HEAD; then
    echo "当前 HEAD 不包含已确认的规格提交 ${base}。" >&2
    exit 1
  fi
  changed="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD)"
  untracked="$(git -C "${REPO_ROOT}" ls-files --others --exclude-standard)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "自规格提交起的改动文件数" "$(printf '%s\n' "${changed}" | sed '/^$/d' | wc -l | tr -d ' ')" >> "${ATDD_LOG}"
  if ! grep -q '^jasagent-gateway/' <<< "${changed}"; then
    echo "实现没有改到 jasagent-gateway。" >&2
    exit 1
  fi
  web="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD -- jasagent-web)"
  web_untracked="$(git -C "${REPO_ROOT}" ls-files --others --exclude-standard -- jasagent-web)"
  k8s="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD -- deploy/k8s)"
  k8s_untracked="$(git -C "${REPO_ROOT}" ls-files --others --exclude-standard -- deploy/k8s)"
  k8s_dirty="$(git -C "${REPO_ROOT}" status --porcelain -- deploy/k8s jasagent-web)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "jasagent-web 改动" "${web:-无}${web_untracked:+; 未跟踪 ${web_untracked}}" >> "${ATDD_LOG}"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "deploy/k8s 改动" "${k8s:-无}${k8s_untracked:+; 未跟踪 ${k8s_untracked}}" >> "${ATDD_LOG}"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "工作区清单和界面" "${k8s_dirty:-干净}" >> "${ATDD_LOG}"
  if [[ -n "${web}${web_untracked}${k8s}${k8s_untracked}${k8s_dirty}" ]]; then
    echo "实现或测试改动了 jasagent-web 或 deploy/k8s：" >&2
    printf '%s\n' "${web}" "${web_untracked}" "${k8s}" "${k8s_untracked}" "${k8s_dirty}" >&2
    exit 1
  fi
  allowed_extra=0
  while IFS= read -r path; do
    [[ -z "${path}" ]] && continue
    case "${path}" in
      jasagent-gateway/*) ;;
      changelog/2026-11-17-gateway-public-ingress.md) ;;
      scripts/test-019-gateway-public-ingress.sh) ;;
      requirements/019-gateway-public-ingress/*) ;;
      *)
        echo "改动超出 019 允许范围：${path}" >&2
        allowed_extra=1
        ;;
    esac
  done <<< "$(printf '%s\n%s\n' "${changed}" "${untracked}")"
  if [[ "${allowed_extra}" -ne 0 ]]; then
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "只改 jasagent-gateway，未改 jasagent-web 和 deploy/k8s" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
