#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-004"
result_text='任意客户端自己带来的 `X-Forwarded-*` 不被信任，不能据此把 Cookie 设成 Secure，也不能据此改跳转或协议。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  props="${REPO_ROOT}/jasagent-gateway/src/main/resources/application.properties"
  filter="${REPO_ROOT}/jasagent-gateway/src/main/java/dev/jasagent/gateway/ingress/TrustedForwardedHeaderFilter.java"
  proxies="${REPO_ROOT}/jasagent-gateway/src/main/java/dev/jasagent/gateway/ingress/TrustedProxyList.java"
  if ! grep -F -q -x 'jasagent.gateway.forwarded.trusted=${JASAGENT_GATEWAY_FORWARDED_TRUSTED:}' "${props}"; then
    echo "信任名单默认不是空白，客户端自带的转发头可能被采信。" >&2
    exit 1
  fi
  if ! grep -q '^server.forward-headers-strategy=none$' "${props}"; then
    echo "容器仍可能按私网默认名单信任客户端自带的转发头。" >&2
    exit 1
  fi
  if ! grep -q 'if (!proxies.trusts(request.getRemoteAddr()))' "${filter}"; then
    echo "过滤器没有按套接字对端决定是否信任转发头。" >&2
    exit 1
  fi
  if ! grep -q 'new UntrustedRequest(request)' "${filter}"; then
    echo "不受信任的请求没有丢掉转发头。" >&2
    exit 1
  fi
  if ! grep -q 'x-forwarded-proto' "${filter}" || ! grep -q 'Forwarded' "${filter}"; then
    echo "过滤器没有覆盖 X-Forwarded-* 或 Forwarded。" >&2
    exit 1
  fi
  if grep -n 'getHeader("X-Forwarded-For")' "${proxies}" | grep -v '//' >/dev/null; then
    echo "信任判断读了 X-Forwarded-For，客户端可以伪造受信任跳。" >&2
    exit 1
  fi
  if ! grep -q 'public boolean trusts(String remoteAddress)' "${proxies}"; then
    echo "信任判断没有按套接字地址实现。" >&2
    exit 1
  fi
  if ! grep -q 'if (!trusts(remote))' "${proxies}"; then
    echo "不受信任时仍可能采用 X-Forwarded-Proto。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "默认空白名单，只看套接字对端，不看 X-Forwarded-For" "通过" >> "${ATDD_LOG}"
  atdd_mvn_test "jasagent-gateway" \
    "PublicIngressFilterTest#untrustedClientCannotChangeSchemeCookieOrRedirect,PublicIngressFilterTest#forwardedHeaderAloneDoesNotImplyHttps,DefaultForwardedTrustTest#loopbackSpoofDoesNotChangeCookieRedirectOrScheme,TrustedProxyListTest#blankListTrustsNobody"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "客户端自带转发头不能改 Cookie、跳转或协议" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
