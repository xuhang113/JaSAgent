#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-012"
result_text='实现提交不修改 `deploy/k8s`。本轮不改公网入口路径，不把 `JASAGENT_GATEWAY_WEB_ORIGIN` 改成公网主机名。口令、令牌和密钥不出现在仓库、说明或日志里。本轮改到的模块有注释、自动测试和可执行测试脚本。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  base="${ATDD_SPEC_BASE}"
  if ! git -C "${REPO_ROOT}" merge-base --is-ancestor "${base}" HEAD; then
    echo "当前 HEAD 不包含已确认的规格提交 ${base}。" >&2
    exit 1
  fi

  k8s="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD -- deploy/k8s)"
  k8s_untracked="$(git -C "${REPO_ROOT}" ls-files --others --exclude-standard -- deploy/k8s)"
  k8s_dirty="$(git -C "${REPO_ROOT}" status --porcelain -- deploy/k8s)"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "deploy/k8s 改动" "${k8s:-无}${k8s_untracked:+; 未跟踪 ${k8s_untracked}}" >> "${ATDD_LOG}"
  if [[ -n "${k8s}${k8s_untracked}${k8s_dirty}" ]]; then
    echo "实现或测试改动了 deploy/k8s：" >&2
    printf '%s\n' "${k8s}" "${k8s_untracked}" "${k8s_dirty}" >&2
    exit 1
  fi

  changed="$(git -C "${REPO_ROOT}" diff --name-only "${base}" HEAD)"
  untracked="$(git -C "${REPO_ROOT}" ls-files --others --exclude-standard)"
  allowed_extra=0
  while IFS= read -r path; do
    [[ -z "${path}" ]] && continue
    case "${path}" in
      jasagent-auth/*|jasagent-persist/*|jasagent-gateway/*|jasagent-web/*) ;;
      changelog/2026-11-18-c-end-tenant-im.md) ;;
      scripts/test-020-c-end-tenant-im.sh) ;;
      requirements/020-c-end-tenant-im/*) ;;
      *)
        echo "改动超出 020 允许范围：${path}" >&2
        allowed_extra=1
        ;;
    esac
  done <<< "$(printf '%s\n%s\n' "${changed}" "${untracked}")"
  if [[ "${allowed_extra}" -ne 0 ]]; then
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "实现只改允许的模块" "通过" >> "${ATDD_LOG}"

  props="${REPO_ROOT}/jasagent-gateway/src/main/resources/application.properties"
  if ! grep -q '^jasagent.gateway.web-origin=http://127.0.0.1:18722$' "${props}"; then
    echo "本机 web 上游被改掉了。" >&2
    exit 1
  fi
  if grep -R -n -E 'https?://[^[:space:]]*ts\.net|[A-Za-z0-9][A-Za-z0-9.-]*\.ts\.net' \
    "${REPO_ROOT}/jasagent-web/frontend" "${props}" >/dev/null; then
    echo "前端或网关配置写进了公网主机名。" >&2
    exit 1
  fi
  if grep -R -n -E 'jdbc:[^[:space:]"]*password=' \
    "${REPO_ROOT}/jasagent-auth/src" \
    "${REPO_ROOT}/jasagent-gateway/src/main" \
    "${REPO_ROOT}/jasagent-persist/src/main" \
    "${REPO_ROOT}/jasagent-web" >/dev/null; then
    echo "JDBC 地址里带了 password=。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "web 上游仍是本机地址且无公网主机名" "通过" >> "${ATDD_LOG}"

  script="${REPO_ROOT}/scripts/test-020-c-end-tenant-im.sh"
  if [[ ! -x "${script}" ]]; then
    echo "实现提交的合同测试脚本不可执行。" >&2
    exit 1
  fi
  if ! head -n 5 "${script}" | grep -q '^#'; then
    echo "合同测试脚本缺少说明注释。" >&2
    exit 1
  fi
  atdd_assert_comments "${script}" 1
  if ! grep -q '第 1 到第 13 条' "${script}" || ! grep -q '第 14 到第 16 条' "${script}"; then
    echo "合同测试脚本没有写明只覆盖验收第 1 到第 13 条，并把第 14 到第 16 条留给部署。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "合同测试脚本可执行且有说明注释" "通过" >> "${ATDD_LOG}"

  python3 - "${REPO_ROOT}" "${ATDD_SPEC_BASE}" <<'PY'
import pathlib
import re
import subprocess
import sys

repo, base = sys.argv[1], sys.argv[2]
modules = ("jasagent-auth/", "jasagent-persist/", "jasagent-gateway/", "jasagent-web/")

def is_main_java(path):
    return path.endswith(".java") and "/src/main/java/" in path and path.startswith(modules)

def is_declaration(stripped):
    if not stripped:
        return False
    # SQL 片段、字符串里的建表语句不是 Java 符号。
    if stripped.startswith(("//", "/*", "*", "@", "package ", "import ", "return ", "throw ", "new ", "if ", "for ", "while ", "switch ", "catch ", "else ", "try ", "assert ", "case ", "this(", "super(", "synchronized (", "CREATE ", "PRIMARY ", "UNIQUE ", "FOREIGN ", "KEY ", "INDEX ", "CONSTRAINT ")):
        return False
    if any(token in stripped for token in ("CREATE TABLE", "PRIMARY KEY", "UNIQUE KEY", "FOREIGN KEY")):
        return False
    if stripped.startswith("}") or stripped.startswith("default:"):
        return False
    if re.search(r"\b(class|interface|enum|record)\s+\w+", stripped):
        return True
    if re.search(r"\b(public|protected)\s+(static\s+final|final\s+static)\s+", stripped) and re.search(r"\b[A-Za-z_][A-Za-z0-9_]*\s*=", stripped):
        return True
    if "(" not in stripped:
        return False
    head = stripped.split("(", 1)[0].strip()
    if "=" in head or not re.search(r"\b[A-Za-z_][A-Za-z0-9_]*$", head):
        return False
    if re.search(r"\b(public|protected|private)\b", head):
        return True
    return bool(re.search(r"\b(void|boolean|byte|short|char|int|long|float|double|[A-Z][A-Za-z0-9_.<>,\s\[\]]*)\s+[A-Za-z_][A-Za-z0-9_]*$", head))

def has_javadoc(lines, index):
    i = index - 1
    skipping_annotation = False
    while i >= 0:
        stripped = lines[i].strip()
        if stripped == "" or stripped.startswith("//"):
            i -= 1
            continue
        if skipping_annotation:
            if stripped.startswith("@"):
                skipping_annotation = False
            i -= 1
            continue
        if stripped.endswith("*/") or stripped.startswith("/**") or stripped.startswith("*"):
            return True
        if stripped.startswith("@"):
            i -= 1
            continue
        if re.match(r"^[@A-Za-z0-9_.,(){}\[\]=\s]+$", stripped) and any(token in stripped for token in ("(", ")", "{", "}", ",")):
            skipping_annotation = True
            i -= 1
            continue
        return False
    return False

diff = subprocess.check_output(["git", "-C", repo, "diff", "-U0", base, "HEAD", "--", "**.java"], text=True)
current = None
wanted = {}
for line in diff.splitlines():
    if line.startswith("+++ b/"):
        current = line[6:]
        continue
    if current is None or not is_main_java(current):
        continue
    if not line.startswith("+") or line.startswith("+++"):
        continue
    body = line[1:].strip()
    if is_declaration(body):
        wanted.setdefault(current, []).append(body)

if not wanted:
    raise SystemExit("本轮没有新增或改动的 Java 实现符号。")

missing = []
for rel, decls in wanted.items():
    path = pathlib.Path(repo, rel)
    lines = path.read_text(encoding="utf-8").splitlines()
    for decl in decls:
        found = False
        for i, raw in enumerate(lines):
            if raw.strip() != decl:
                continue
            found = True
            if not has_javadoc(lines, i):
                missing.append(f"{rel}:{i + 1} 缺少注释：{decl}")
            break
        if not found:
            missing.append(f"{rel}: 找不到本轮新增或改动的符号：{decl}")
if missing:
    print("本轮新增或改动的实现缺少注释：", file=sys.stderr)
    print("\n".join(missing), file=sys.stderr)
    raise SystemExit(1)
PY
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "本轮新增或改动的 Java 实现注释" "通过" >> "${ATDD_LOG}"

  auto_tests="$(git -C "${REPO_ROOT}" diff --name-only --diff-filter=A "${ATDD_SPEC_BASE}" HEAD -- \
    'jasagent-auth/src/test/java/**' \
    'jasagent-persist/src/test/java/**' \
    'jasagent-gateway/src/test/java/**' \
    'jasagent-web/src/test/java/**' \
    'jasagent-web/frontend/src/**/*.spec.js')"
  if [[ -z "${auto_tests}" ]]; then
    echo "本轮实现没有新增自动测试。" >&2
    exit 1
  fi
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "本轮新增的自动测试" "$(printf '%s\n' "${auto_tests}" | sed '/^$/d' | wc -l | tr -d ' ') 个文件" >> "${ATDD_LOG}"

  leaked="$(
    python3 - "${REPO_ROOT}" "${ATDD_SPEC_BASE}" <<'PY'
import re
import subprocess
import sys

repo, base = sys.argv[1], sys.argv[2]
text = subprocess.check_output(
    [
        "git", "-C", repo, "diff", "-U0", base, "HEAD", "--",
        "*.md", "*.properties", "*.sh", "*.java", "*.js",
        ":!**/logs/**", ":!**/results/**", ":!**/src/test/**", ":!requirements/**",
        ":!**/*.spec.js",
    ],
    text=True,
)

def literal_secret(body):
    if re.search(r"(?i)(atdd_|test_|fake_|dummy_|not-for-logs|-atdd|for-test)", body):
        return None
    for match in re.finditer(
        r"(?i)(?:^|[^\w.])(?:this\.)?(password|token|secret|ticket)\s*=\s*(.+)",
        body,
    ):
        rhs = match.group(2).strip().rstrip(";").strip()
        lower = body.lower()
        if "password-file" in lower or "password_file" in lower or "passwordfile" in lower:
            continue
        if any(mark in body for mark in ("不能带", "不能包含", "含 password=", "包含 password=", "password= must")):
            continue
        if re.search(r"\$\{|\$\(|\$[A-Za-z_]", rhs):
            continue
        if " + " in rhs or "++" in rhs or "?" in rhs:
            continue
        if re.match(r"^(null|None|readSecret\b|[A-Za-z_][A-Za-z0-9_.]*(\s*\(.*\))?)$", rhs):
            continue
        if rhs in ('""', "''"):
            continue
        if re.match(r"^['\"][^'\"]+['\"]$", rhs) or re.match(r"^[A-Za-z0-9_./:+-]{8,}$", rhs):
            return rhs
    return None

bad = []
for line in text.splitlines():
    if not line.startswith("+") or line.startswith("+++"):
        continue
    body = line[1:]
    found = literal_secret(body)
    if found:
        bad.append(body.strip())
print("\n".join(bad))
PY
  )"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "仓库新增行密文检查" "${leaked:-无}" >> "${ATDD_LOG}"
  if [[ -n "${leaked}" ]]; then
    echo "实现提交里出现了口令、令牌或密钥原文：" >&2
    printf '%s\n' "${leaked}" >&2
    exit 1
  fi

  # 不直接跑官方脚本：它会把本目录尚未提交的 ATDD 文件当成超出范围。
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "改动范围、注释、脚本和密文检查完成" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
