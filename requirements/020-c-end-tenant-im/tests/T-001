#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-001"
result_text='未登录可以直接注册（登录名和口令），注册成功后可以用该账号登录，并进入控制台。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  atdd_mvn_test "jasagent-gateway" \
    "CEndTenantImTest#registerCreatesAnOrdinaryTenantAndCanEnterTheConsole"
  atdd_npm_test "src/views/RegisterView.spec.js"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "未登录可注册，注册后可登录并进入控制台" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
