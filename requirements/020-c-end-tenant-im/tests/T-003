#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/lib.sh"
name="T-003"
result_text='新注册用户的角色不是 admin。`GET /api/me` 能区分 admin 与普通用户，并带上该用户自己的租户。'
atdd_begin "$name" "$result_text"
set +e
(
  set -euo pipefail

  atdd_mvn_test "jasagent-auth,jasagent-gateway" \
    "MysqlAccountAuthTest#registrationIsOrdinaryAndSurvivesReopen,CEndTenantImTest#registerCreatesAnOrdinaryTenantAndCanEnterTheConsole,CEndTenantImTest#clusterIsAdminOnlyAndImportedOperatorKeepsAdmin"
  atdd_checkpoint "${ATDD_NAME}" "${ATDD_START_MS}" "/api/me 能区分角色并带上自己的租户" "通过" >> "${ATDD_LOG}"

  exit 0
) >> "$ATDD_LOG" 2>&1
code=$?
set -e
atdd_finish "$code"
exit "$code"
