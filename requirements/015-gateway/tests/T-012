#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
mkdir -p "$HERE/../results" "$HERE/../logs"
name="T-012"
result_text='未配置 `JASAGENT_INTERNAL_TOKEN` 时，已登录的可转发请求不会发到 agent，响应正文不含令牌原文。'
cd "$ROOT"
start=$(python3 -c 'import time; print(int(time.time()*1000))')
set +e
mvn -pl jasagent-gateway -am test -Dsurefire.failIfNoSpecifiedTests=false -Dtest=ConsoleProxyTest#missingInternalTokenDoesNotCallAnAgent > "$HERE/../logs/${name}.log" 2>&1
code=$?
set -e
end=$(python3 -c 'import time; print(int(time.time()*1000))')
elapsed=$((end - start))
if [[ $code -eq 0 ]]; then
  status="通过"
else
  status="失败"
fi
printf '%s\t%s\t%s\t%s\tlogs/%s.log\n' "$name" "$status" "$result_text" "$elapsed" "$name" > "$HERE/../results/${name}.txt"
exit "$code"
