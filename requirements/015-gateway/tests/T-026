#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
mkdir -p "$HERE/../results" "$HERE/../logs"
name="T-026"
result_text='按本机启动方式拉起后，18721 是网关，18731 和 18732 是 agent，`jasagent-app` 不再默认监听 18721。'
cd "$ROOT"
start=$(python3 -c 'import time; print(int(time.time()*1000))')
set +e
(
  mvn -pl jasagent-gateway -am test -Dsurefire.failIfNoSpecifiedTests=false -Dtest=StartScriptTest#startScriptLaunchesGatewayWebAndAgents
  c1=$?
  if [[ $c1 -ne 0 ]]; then
    exit $c1
  fi
  mvn -pl jasagent-app -am test -Dsurefire.failIfNoSpecifiedTests=false -Dtest=DefaultPortTest#applicationPropertiesUseAgentPort,DefaultPortTest#applicationMainDefaultsToAgentPort
  exit $?
) > "$HERE/../logs/${name}.log" 2>&1
code=$?
set -e
end=$(python3 -c 'import time; print(int(time.time()*1000))')
elapsed=$((end - start))
if [[ $code -eq 0 ]]; then
  status="通过"
else
  status="失败"
fi
printf '%s\t%s\t%s\t%s\tlogs/%s.log\n' "$name" "$status" "$result_text" "$elapsed" "$name" > "$HERE/../results/${name}.txt"
exit "$code"
