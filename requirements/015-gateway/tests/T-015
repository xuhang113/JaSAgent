#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
mkdir -p "$HERE/../results" "$HERE/../logs"
name="T-015"
result_text='已登录访问 `GET /admin/` 时，网关把请求反向代理到配置的 web 上游，响应正文来自这个上游。'
cd "$ROOT"
start=$(python3 -c 'import time; print(int(time.time()*1000))')
set +e
mvn -pl jasagent-gateway -am test -Dsurefire.failIfNoSpecifiedTests=false -Dtest=ConsoleProxyTest#signedInConsoleComesFromTheUpstream > "$HERE/../logs/${name}.log" 2>&1
code=$?
set -e
end=$(python3 -c 'import time; print(int(time.time()*1000))')
elapsed=$((end - start))
if [[ $code -eq 0 ]]; then
  status="通过"
else
  status="失败"
fi
printf '%s\t%s\t%s\t%s\tlogs/%s.log\n' "$name" "$status" "$result_text" "$elapsed" "$name" > "$HERE/../results/${name}.txt"
exit "$code"
