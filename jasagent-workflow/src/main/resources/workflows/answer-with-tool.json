{
  "id": "answer-with-tool",
  "rules": ["base"],
  "skills": ["research"],
  "budgetTokens": 8000,
  "nodes": [
    {
      "id": "find",
      "type": "retrieve",
      "queryFrom": "input",
      "topK": 5,
      "scopes": ["user", "workspace"],
      "required": false
    },
    {
      "id": "act",
      "type": "react",
      "maxSteps": 6,
      "tools": ["clock", "rag.search"],
      "grounding": true
    },
    {
      "id": "grade",
      "type": "evaluate",
      "evaluator": "tool.success.rate",
      "required": false
    },
    {
      "id": "done",
      "type": "end"
    }
  ]
}
